# Booking form (app/api/booking/route.ts). Set these in Vercel -> Project -> Settings -> Environment Variables.
# For local testing, put the same lines in .env.local (never commit .env.local).
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Optional: where bookings go (comma-separated). Defaults to GMAIL_USER.
BOOKING_TO=
# Optional: also post bookings to a Discord channel
DISCORD_WEBHOOK_URL=
